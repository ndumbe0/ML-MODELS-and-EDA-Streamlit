# =============================================================================
# ML-MODELS-and-EDA-Streamlit - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# Never commit the real .env file to version control.

# Google AI (Gemini) API key for the AI Assistant feature
# Get one at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Application authentication (optional - for src/authenticationapp.py)
APP_USERNAME=
APP_PASSWORD=
